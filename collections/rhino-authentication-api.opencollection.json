{
  "opencollection": "1.0.0",
  "info": {
    "name": "SayRhino Partner Authentication API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Request an access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Obtain a JWT via OAuth2 client_credentials grant."
        }
      ]
    }
  ],
  "bundled": true
}